# Copy to .env.local. Both values are public by design and are baked into the build.
# Local: printed by `pnpm db:start` (API URL and anon/publishable key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Android only: the Google OAuth *web* client ID (the same one Supabase's Google provider
# uses). Native sign-in asks Google for an ID token issued to this client.
VITE_GOOGLE_WEB_CLIENT_ID=
